# Base URL the frontend calls for the REST API.
# In dev, Vite proxies /api to VITE_API_PROXY_TARGET (see vite.config.ts), so this can stay relative.
VITE_API_BASE_URL=/api/v1

# Socket.io server URL (used starting with the Dashboard module)
VITE_SOCKET_URL=http://localhost:5000

# Only read by the Vite dev server proxy, not bundled into the client
VITE_API_PROXY_TARGET=http://localhost:5000
